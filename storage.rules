rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth != null && request.auth.token.admin == true; }
  match /listings/{listingId}/{imageId} {
   allow read: if admin() || firestore.get(/databases/(default)/documents/listings/$(listingId)).data.status == 'published';
   allow create, update: if admin() && request.resource.size < 5 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)');
   allow delete: if admin();
  }
  match /blogmedia/{postId}/{imageId} {
   allow read: if true;
   allow create,update: if admin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
   allow delete: if admin();
  }
  match /popupmedia/{campaignId}/{imageId} {
   allow read: if true;
   allow create,update: if admin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
   allow delete: if admin();
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
